{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/checkout/29700",
      "destination": "/nutricao.html"
    },
    {
      "source": "/checkout/39770",
      "destination": "/nutricao.html"
    },
    {
      "source": "/checkout/59940",
      "destination": "/nutricao.html"
    },
    {
      "source": "/checkout/39700",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
